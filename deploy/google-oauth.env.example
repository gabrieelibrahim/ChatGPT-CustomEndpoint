# Private server env only; never put real credentials into Git or the APK.
SUPERGPT_PUBLIC_ORIGIN=https://sakelar.web.id
SUPERGPT_GOOGLE_CLIENT_ID=
SUPERGPT_GOOGLE_CLIENT_SECRET=
SUPERGPT_GOOGLE_TOKEN_KEY=
SUPERGPT_GOOGLE_DATA=/var/lib/supergpt-google
SUPERGPT_GOOGLE_PORT=1431
SUPERGPT_GOOGLE_PUBLIC_LOGIN=true
SUPERGPT_GOOGLE_TRUST_PROXY=true
SUPERGPT_ALLOWED_ORIGINS=https://sakelar.web.id,https://tauri.localhost,http://tauri.localhost,tauri://localhost
